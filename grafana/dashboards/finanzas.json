        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
          "format": "table",
          "rawSql": "SELECT\n  CASE\n    WHEN NOW() - \"fecha\" <= INTERVAL '30 days' THEN '0-30 días'\n    WHEN NOW() - \"fecha\" <= INTERVAL '60 days' THEN '31-60 días'\n    WHEN NOW() - \"fecha\" <= INTERVAL '90 days' THEN '61-90 días'\n    ELSE '90+ días'\n  END AS rango,\n  COUNT(*) AS cantidad,\n  SUM(\"totalGeneral\") AS total\nFROM \"Factura\"\nWHERE estado IN ('PENDIENTE', 'VENCIDA') AND \"fecha\" >= $__timeFrom() AND \"fecha\" <= $__timeTo()\nGROUP BY rango ORDER BY rango",
          "refId": "A"
        }
      ]
