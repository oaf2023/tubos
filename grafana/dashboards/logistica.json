  },
  "description": "Dashboard de logística y flota para el sistema GasTrack AR",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Indicadores del Período",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 10 },
              { "color": "super-light-green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Rutas del Período",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
          "format": "table",
          "rawSql": "(SELECT COUNT(*) FROM \"Ruta\" WHERE \"fecha\" >= $__timeFrom() AND \"fecha\" <= $__timeTo())",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "lengthkm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 500 },
              { "color": "super-light-green", "value": 2000 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "KM Totales",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
          "format": "table",
          "rawSql": "(SELECT COALESCE(ROUND(SUM(\"distanciaKm\")::numeric, 1), 0) FROM \"Ruta\" WHERE \"fecha\" >= $__timeFrom() AND \"fecha\" <= $__timeTo())",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "lengthkm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 100 },
              { "color": "super-light-green", "value": 250 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "KM Promedio",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
          "format": "table",
          "rawSql": "(SELECT COALESCE(ROUND(AVG(\"distanciaKm\")::numeric, 1), 0) FROM \"Ruta\" WHERE \"fecha\" >= $__timeFrom() AND \"fecha\" <= $__timeTo())",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "green", "value": 8 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 15, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Vehículos Activos",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
          "format": "table",
          "rawSql": "(SELECT COUNT(*) FROM \"Vehiculo\" WHERE estado = 'ACTIVO')",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 6 },
              { "color": "green", "value": 8 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 19, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Rendimiento Promedio",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
          "format": "table",
          "rawSql": "(SELECT COALESCE(ROUND(AVG(cc.rendimiento)::numeric, 1), 0) FROM \"CargaCombustible\" cc WHERE cc.fecha >= $__timeFrom() AND cc.rendimiento IS NOT NULL)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "Análisis de Rutas",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "distancia_km" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "lengthkm" }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 7 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["sum", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Rutas por Mes",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
          "format": "time_series",
          "rawSql": "SELECT DATE_TRUNC('month', \"fecha\") AS time, COUNT(*) AS total_rutas, SUM(\"distanciaKm\") AS distancia_km\nFROM \"Ruta\" WHERE \"fecha\" >= $__timeFrom() AND \"fecha\" <= $__timeTo()\nGROUP BY time ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 7 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "title": "Rutas por Estado",
      "type": "piechart",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
          "format": "table",
          "rawSql": "SELECT estado, COUNT(*) AS cantidad FROM \"Ruta\"\nWHERE \"fecha\" >= $__timeFrom() AND \"fecha\" <= $__timeTo()\nGROUP BY estado ORDER BY cantidad DESC",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 102,
      "title": "Flota y Combustible",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "estado" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "options": { "ACTIVO": { "color": "green", "index": 0, "text": "ACTIVO" }, "INACTIVO": { "color": "orange", "index": 1, "text": "INACTIVO" } }, "type": "value" }
                ]
              },
              { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "color-background" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 18 },
      "id": 8,
      "options": { "showHeader": true, "footer": { "show": false } },
      "title": "Flota de Vehículos",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
          "format": "table",
          "rawSql": "SELECT v.codigo, v.patente, v.estado, v.\"maxTubos\" AS capacidad_tubos, v.\"kmActual\" AS km_actuales, v.tipo, v.combustible,\n  (SELECT COUNT(*) FROM \"Ruta\" r WHERE r.\"vehiculoId\" = v.id AND r.\"fecha\" >= $__timeFrom()) AS rutas_periodo\nFROM \"Vehiculo\" v WHERE v.estado != 'BAJA' ORDER BY rutas_periodo DESC",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "km/l",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 18 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Rendimiento de Combustible",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
          "format": "time_series",
          "rawSql": "SELECT DATE_TRUNC('month', cc.fecha) AS time, AVG(cc.rendimiento) AS rendimiento_promedio, v.patente AS vehiculo\nFROM \"CargaCombustible\" cc JOIN \"Vehiculo\" v ON cc.\"vehiculoId\" = v.id\nWHERE cc.fecha >= $__timeFrom() AND cc.fecha <= $__timeTo() AND cc.rendimiento IS NOT NULL\nGROUP BY time, v.patente ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "id": 103,
      "title": "Cargas y Mantenimiento",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "tubos",
            "axisPlacement": "auto",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineWidth": 1,
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 29 },
      "id": 10,
      "options": {
        "barRadius": 0.05,
        "barWidth": 0.7,
        "fullHighlight": false,
        "groupWidth": 0.7,
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true },
        "orientation": "auto",
        "showValue": "auto",
        "stacking": "none",
        "tooltip": { "mode": "multi", "sort": "desc" },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100
      },
      "title": "Carga de Tubos por Vehículo",
      "type": "barchart",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
          "format": "table",
          "rawSql": "SELECT v.patente, COUNT(ci.id) AS tubos_cargados\nFROM \"CargaVehiculo\" cv JOIN \"Vehiculo\" v ON cv.\"vehiculoId\" = v.id\nJOIN \"CargaVehiculoItem\" ci ON ci.\"cargaVehiculoId\" = cv.id\nWHERE cv.estado = 'COMPLETADA' AND cv.fecha >= $__timeFrom() AND cv.fecha <= $__timeTo()\nGROUP BY v.patente ORDER BY tubos_cargados DESC",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "currency"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 29 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Costos de Mantenimiento",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_GASTRACK}" },
          "format": "time_series",
          "rawSql": "SELECT DATE_TRUNC('month', mv.fecha) AS time, SUM(mv.costo) AS costo_total, v.patente AS vehiculo\nFROM \"MantenimientoVehiculo\" mv JOIN \"Vehiculo\" v ON mv.\"vehiculoId\" = v.id\nWHERE mv.fecha >= $__timeFrom() AND mv.fecha <= $__timeTo()\nGROUP BY time, v.patente ORDER BY time",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 38,
  "tags": ["gastrack", "logistica"],
  "templating": { "list": [] },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Logística y Flota - GasTrack AR",
  "uid": "gastrack-logistica",
  "version": 1,
  "weekStart": ""
}
