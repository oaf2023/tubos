      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_GASTRACK}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lp.\"pesoEsperado\" AS x, lp.\"pesoReal\" AS y, c.\"numeroSerie\" AS tubo,\n  CASE WHEN ABS(lp.\"pesoReal\" - lp.\"pesoEsperado\") / NULLIF(lp.\"pesoEsperado\", 0) <= 0.05 THEN 'Normal'\n       WHEN ABS(lp.\"pesoReal\" - lp.\"pesoEsperado\") / NULLIF(lp.\"pesoEsperado\", 0) <= 0.10 THEN 'Advertencia'\n       ELSE 'Crítico' END AS estado\nFROM \"LecturaPeso\" lp JOIN \"Cylinder\" c ON lp.\"cylinderId\" = c.id\nWHERE lp.\"createdAt\" >= $__timeFrom() AND lp.\"createdAt\" <= $__timeTo()",
          "refId": "A"
        }
      ],
      "title": "Peso Esperado vs Real",
      "type": "scatterplot"
