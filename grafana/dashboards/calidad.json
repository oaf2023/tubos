          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE WHEN COUNT(*) > 0 THEN ROUND(COUNT(*) FILTER (WHERE v.\"inconsistente\" = true)::numeric / COUNT(*) * 100, 2) ELSE 0 END AS tasa\nFROM \"ValidacionCabina\" v\nWHERE v.\"createdAt\" >= $__timeFrom() AND v.\"createdAt\" <= $__timeTo()",
          "refId": "A"
        }
      ],
