        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "orientation": "auto",
        "showValue": "auto",
        "stacking": "none",
        "tooltip": { "mode": "multi", "sort": "desc" },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 300
      },
      "title": "Tasa de Rotación por Gas",
      "type": "barchart",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_GASTRACK}" },
          "format": "table",
          "rawSql": "WITH movimientos_recientes AS (\n  SELECT c.\"gasId\", COUNT(m.id) AS movimientos\n  FROM \"CylinderMovimiento\" m JOIN \"Cylinder\" c ON m.\"cylinderId\" = c.id\n  WHERE m.fecha >= NOW() - INTERVAL '30 days'\n  GROUP BY c.\"gasId\"\n),\nstock_total AS (\n  SELECT \"gasId\", SUM(llenos + vacios + \"enReparto\" + \"enCarga\" + mantenimiento) AS total\n  FROM \"StockGas\" GROUP BY \"gasId\"\n)\nSELECT g.codigo AS gas, COALESCE(mr.movimientos, 0) AS movimientos_30d, st.total AS stock_total,\n  CASE WHEN st.total > 0 THEN ROUND(COALESCE(mr.movimientos, 0)::numeric / st.total, 2) ELSE 0 END AS tasa_rotacion\nFROM stock_total st JOIN \"Gas\" g ON st.\"gasId\" = g.id\nLEFT JOIN movimientos_recientes mr ON st.\"gasId\" = mr.\"gasId\"\nORDER BY tasa_rotacion DESC",
          "refId": "A"
        }
      ]
    }
