        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Movimientos por Mes",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_GASTRACK}" },
          "format": "time_series",
          "rawSql": "SELECT DATE_TRUNC('month', \"fecha\") AS time, COUNT(*) AS movimientos\nFROM \"CylinderMovimiento\"\nWHERE \"fecha\" >= $__timeFrom() AND \"fecha\" <= $__timeTo()\nGROUP BY time ORDER BY time",
          "refId": "A"
        }
      ]
    },
