      "title": "PH: Vencidos y Próximos a Vencer",
      "type": "barchart",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_GASTRACK}" },
          "format": "table",
          "rawSql": "SELECT 'Vencidos' AS estado, COUNT(*) AS cantidad FROM \"Cylinder\" WHERE \"fechaProximoRetest\" < NOW() AND estado != 'BAJA'\nUNION ALL\nSELECT 'Vence 30 días', COUNT(*) FROM \"Cylinder\" WHERE \"fechaProximoRetest\" >= NOW() AND \"fechaProximoRetest\" < NOW() + INTERVAL '30 days' AND estado != 'BAJA'\nUNION ALL\nSELECT 'Vence 60 días', COUNT(*) FROM \"Cylinder\" WHERE \"fechaProximoRetest\" >= NOW() + INTERVAL '30 days' AND \"fechaProximoRetest\" < NOW() + INTERVAL '60 days' AND estado != 'BAJA'\nUNION ALL\nSELECT 'Vence 90 días', COUNT(*) FROM \"Cylinder\" WHERE \"fechaProximoRetest\" >= NOW() + INTERVAL '60 days' AND \"fechaProximoRetest\" < NOW() + INTERVAL '90 days' AND estado != 'BAJA'",
          "refId": "A"
        }
      ]
    },
